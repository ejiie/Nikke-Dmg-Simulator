# DataPipeline 비밀/설정 템플릿
# 사용법: 이 파일을 같은 폴더에 `.env` 로 복사한 뒤 실제 값을 채운다.
#   cp DataPipeline/.env.example DataPipeline/.env
# `.env` 는 .gitignore 처리됨 — 절대 커밋하지 말 것. 이 .example 만 커밋한다.

# ── BlaBlaLink 크롤러 (getFromBlaLink.py) ──
NIKKE_UID=                 # 유저 UID(숫자). CLI 인자로도 전달 가능
NIKKE_BLABLA_ID=           # 로그인 ID(이메일)
NIKKE_BLABLA_PW=           # 로그인 비밀번호
# 크롤러가 locale=en-US 를 강제(영문 사전 캡처용)라 로그인 UI 가 영어로 뜬다.
# region 도 영어 표기로 매칭 — 한국 포함 옵션 = 'JP/KR/NA/SEA/Global'. 비우면 이 값이 기본.
NIKKE_REGION=JP/KR/NA/SEA/Global

# ── LLM 스킬 파서 (schema/skill_parser_llm.py) ──
GEMINI_API_KEY=            # Google Gemini API 키
