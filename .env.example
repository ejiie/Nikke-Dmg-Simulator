# Gemini API 키 설정. 이 파일을 `.env` 로 복사한 뒤 값을 채우세요.
# .env 는 .gitignore 에 등록되어야 합니다 (키 유출 방지).
#
# 아래 세 가지 포맷 중 하나를 선택. 여러 개 동시 사용해도 무방 (중복은 자동 제거).
# skill_parser_llm.py 의 ApiKeyRotator 가 세션 중 quota 소진 시 자동 교체합니다.

# ─── 포맷 1: 콤마 구분 (가장 간단, 권장) ───────────────────────────
GEMINI_API_KEYS=AIzaSy...key1,AIzaSy...key2,AIzaSy...key3

# ─── 포맷 2: 넘버링 (키가 많고 개별 관리하고 싶을 때) ──────────────
# GEMINI_API_KEY_1=AIzaSy...key1
# GEMINI_API_KEY_2=AIzaSy...key2
# GEMINI_API_KEY_3=AIzaSy...key3

# ─── 포맷 3: 단일 키 (기존 호환) ──────────────────────────────────
# GEMINI_API_KEY=AIzaSy...singlekey
